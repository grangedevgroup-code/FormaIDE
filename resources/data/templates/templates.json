    "id": "forma-plugin",
    "name": "FormaIDE plugin",
    "description": "A plugin that adds a code generator to FormaIDE, written in Python.",
    "category": "Library",
    "platforms": ["windows", "macos", "linux"],
    "language": "Python",
    "framework": "FormaIDE plugin API",
    "generator": "",
    "tools": ["python"],
    "starter": "none",
    "preview": "none",
    "files": {
      "forma-plugin.json": "{\n  \"id\": \"{{bundleId}}\",\n  \"name\": \"{{name}}\",\n  \"version\": \"0.1.0\",\n  \"publisher\": \"You\",\n  \"apiVersion\": 1,\n  \"permissions\": [],\n  \"contributes\": {\n    \"generators\": [\n      {\n        \"id\": \"{{slug}}\",\n        \"label\": \"{{name}}\",\n        \"language\": \"Markdown\",\n        \"framework\": \"None\",\n        \"platforms\": [],\n        \"command\": [\"python\", \"generator.py\"]\n      }\n    ]\n  }\n}\n",
      "generator.py": "import json\nimport sys\n\nrequest = json.load(sys.stdin)\nmodel = request[\"model\"]\nlines = [\"# \" + model[\"meta\"][\"name\"], \"\"]\nfor screen in model[\"screens\"]:\n    lines.append(\"- \" + screen.get(\"name\", screen[\"id\"]))\njson.dump({\"files\": [{\"path\": \"SCREENS.md\", \"content\": \"\\n\".join(lines) + \"\\n\", \"category\": \"generated\"}]}, sys.stdout)\n",
      "README.md": "# {{name}}\n\nA FormaIDE plugin. Install it from Settings, Plugins, then pick this folder.\n"
    }
  }
