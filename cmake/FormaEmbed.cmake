function(forma_embed_directory output_file source_directory)
    file(GLOB_RECURSE files RELATIVE "${source_directory}" CONFIGURE_DEPENDS "${source_directory}/*")
    list(SORT files)
    set(body "#include \"forma/resources/resources.h\"\n\nnamespace forma::resources::detail {\n\n")
    set(table "")
    set(index 0)
    foreach(file IN LISTS files)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_directory}/${file}")
        file(READ "${source_directory}/${file}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND body "static const unsigned char data${index}[] = {${bytes}0x00};\n")
        string(APPEND table "    {\"${file}\", data${index}, ${size}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND body "\nconst EmbeddedFile embeddedFiles[] = {\n${table}    {nullptr, nullptr, 0},\n};\n\n}\n")
    file(CONFIGURE OUTPUT "${output_file}" CONTENT "${body}" @ONLY)
endfunction()
